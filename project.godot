; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are meant to be set
; by the editor UI and not by hand, though you can partially
; feel free to edit them.

config_version=5

[application]

config/name="Low-Poly Exploration"
config/description="Ambient open-world exploration on a procedurally generated cube-sphere planet. GameCube-era low-poly look."
config/features=PackedStringArray("4.3", "Forward Plus")
run/main_scene="res://scenes/main.tscn"
run/max_fps=60
config/icon="res://icon.svg"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[autoload]

World="*res://scripts/core/world.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_3="creature_hitboxes"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
scaling_3d/mode=0
scaling_3d/scale=0.8
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=0

[shader_globals]

look_fog_color={
"type": "vec3",
"value": Vector3(0.26327, 0.60383, 1)
}
look_fog_density={
"type": "float",
"value": 0.0004
}
