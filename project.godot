; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are meant to be set
; by the editor UI and not by hand, though you can partially
; feel free to edit them.

config_version=5

[application]

config/name="Low-Poly Exploration"
config/description="Ambient open-world exploration on a procedurally generated cube-sphere planet. GameCube-era low-poly look."
config/features=PackedStringArray("4.3", "Forward Plus")
run/main_scene="res://scenes/boot.tscn"
run/max_fps=60
config/icon="res://icon.svg"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[autoload]

World="*res://scripts/core/world.gd"

[display]

window/size/viewport_width=854
window/size/viewport_height=480
window/size/mode=2
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[layer_names]

3d_physics/layer_3="creature_hitboxes"

[rendering]

limits/global_shader_variables/buffer_size=262144

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/atlas_size=1024

