		{"name": "Great white shark", "genus": "Carcharodon", "species": "carcharias", "role": "water_edge", "body": "shark", "spawn": "ambient", "temp_c": [10, 24], "moisture": [0, 1], "active": "day", "one_per_radius_m": 400, "needs": {"open_water": true, "salt": true}, "size_m": 5.0, "color": "#5A6068", "accent": "#E4E6E2", "speed_mps": 4.5, "shy_m": 0, "sound": "none", "trophic": "apex", "diet": ["seals", "fish", "dolphins"], "temperament": "aggressive", "charge_m": 30, "bite": 55, "hp": 180, "hit_parts": {"body": 1.0, "head": 1.4, "eye": 4.0}, "herd_min": 1, "herd_max": 1, "source": "Cool and temperate coasts worldwide, off seal colonies, rocky shores and kelp; the big one \u2014 the fin comes up, then it hits from below."},
