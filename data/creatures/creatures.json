		{"name": "Shore crab", "genus": "Carcinus", "species": "maenas", "role": "water_edge", "body": "beetle", "spawn": "ambient", "temp_c": [2, 24], "moisture": [0.3, 1], "active": "any", "one_per_radius_m": 12, "needs": {"shore": true, "salt": true}, "size_m": 0.08, "color": "#3E5A3A", "accent": "#C8A060", "speed_mps": 0.9, "shy_m": 3, "sound": "none", "trophic": "scavenger", "diet": ["carrion", "molluscs", "worms"], "temperament": "skittish", "herd_min": 2, "herd_max": 6, "burrow": "under_stones", "source": "Temperate rocky and muddy shores worldwide; green shore crab; scuttles sideways under stones and weed when you come close."},
		{"name": "Ghost crab", "genus": "Ocypode", "species": "quadrata", "role": "water_edge", "body": "beetle", "spawn": "ambient", "temp_c": [18, 32], "moisture": [0.2, 1], "active": "night", "one_per_radius_m": 10, "needs": {"shore": true, "salt": true}, "size_m": 0.06, "color": "#D8C8A0", "accent": "#F0E8D0", "speed_mps": 2.5, "shy_m": 6, "sound": "none", "trophic": "scavenger", "diet": ["carrion", "turtle_eggs", "insects"], "temperament": "skittish", "herd_min": 1, "herd_max": 4, "burrow": "sand", "source": "Tropical and subtropical sandy beaches; pale sand-coloured, near invisible until it runs; fastest crab on land; bolts sideways into a burrow above the tide line; raids turtle nests at night."},
		{"name": "Fiddler crab", "genus": "Leptuca", "species": "pugilator", "role": "water_edge", "body": "beetle", "spawn": "ambient", "temp_c": [16, 32], "moisture": [0.5, 1], "active": "day", "one_per_radius_m": 6, "needs": {"shore": true, "salt": true}, "size_m": 0.03, "color": "#6A5A50", "accent": "#E8D080", "speed_mps": 0.6, "shy_m": 2, "sound": "none", "trophic": "scavenger", "diet": ["detritus", "algae"], "temperament": "skittish", "herd_min": 10, "herd_max": 40, "burrow": "mud", "source": "Mudflats, mangroves and salt marsh; colonies of dozens; males wave one huge pale claw; the whole flat vanishes down its burrows when a shadow passes."},
		{"name": "Freshwater crab", "genus": "Potamon", "species": "fluviatile", "role": "water_edge", "body": "beetle", "spawn": "ambient", "temp_c": [8, 28], "moisture": [0.4, 1], "active": "night", "one_per_radius_m": 25, "needs": {"shore": true, "water_within_m": 5}, "size_m": 0.07, "color": "#5A4A3A", "accent": "#A07A50", "speed_mps": 0.8, "shy_m": 3, "sound": "none", "trophic": "scavenger", "diet": ["carrion", "insects", "snails"], "temperament": "skittish", "herd_min": 1, "herd_max": 2, "burrow": "stream_bank", "source": "Streams and rivers of southern Europe and the Mediterranean; hides under stones in the shallows by day, forages the bank at night."},
		{"name": "Nile crocodile", "genus": "Crocodylus", "species": "niloticus", "role": "water_edge", "body": "quadruped", "spawn": "ambient", "temp_c": [20, 32], "moisture": [0.4, 1], "active": "any", "one_per_radius_m": 140, "needs": {"shore": true, "water_within_m": 8}, "size_m": 4.5, "color": "#4A5A3A", "accent": "#B8B070", "speed_mps": 4.5, "shy_m": 0, "sound": "hiss", "trophic": "apex", "diet": ["fish", "antelope", "anything at the water"], "temperament": "aggressive", "charge_m": 9, "bite": 40, "hp": 120, "hit_parts": {"body": 0.5, "head": 1.2, "eye": 4.0}, "herd_min": 1, "herd_max": 3, "source": "African rivers, lakes and swamps; lies still as a log at the water's edge and explodes out of the shallows at anything that comes to drink; armoured back (body hits do half), the eye and the soft throat are the way in."},
		{"name": "Saltwater crocodile", "genus": "Crocodylus", "species": "porosus", "role": "water_edge", "body": "quadruped", "spawn": "ambient", "temp_c": [22, 33], "moisture": [0.5, 1], "active": "any", "one_per_radius_m": 220, "needs": {"shore": true, "salt": true}, "size_m": 5.5, "color": "#3E4A36", "accent": "#A8A060", "speed_mps": 4, "shy_m": 0, "sound": "hiss", "trophic": "apex", "diet": ["fish", "crabs", "buffalo", "anything at the water"], "temperament": "aggressive", "charge_m": 10, "bite": 50, "hp": 160, "hit_parts": {"body": 0.5, "head": 1.2, "eye": 4.0}, "herd_min": 1, "herd_max": 1, "source": "Mangroves, estuaries and coasts from India to northern Australia; the largest living reptile; a lone ambush hunter that will take a person from a canoe or the bank."},
		{"name": "American alligator", "genus": "Alligator", "species": "mississippiensis", "role": "water_edge", "body": "quadruped", "spawn": "ambient", "temp_c": [13, 30], "moisture": [0.55, 1], "active": "any", "one_per_radius_m": 90, "needs": {"shore": true, "water_within_m": 8}, "size_m": 3.5, "color": "#2E3A2E", "accent": "#C8C090", "speed_mps": 3.5, "shy_m": 0, "sound": "croak", "trophic": "apex", "diet": ["fish", "turtles", "birds", "deer"], "temperament": "aggressive", "charge_m": 5, "bite": 28, "hp": 90, "hit_parts": {"body": 0.5, "head": 1.2, "eye": 4.0}, "hibernate": true, "herd_min": 1, "herd_max": 4, "source": "Swamps, bayous and slow rivers of the SE United States; basks in numbers on the bank, bellows in spring; mostly leaves you alone unless you get right up to it or between it and the water; torpid in cold weather."},
		{"name": "Hippopotamus", "genus": "Hippopotamus", "species": "amphibius", "role": "water_edge", "body": "quadruped", "spawn": "ambient", "temp_c": [20, 32], "moisture": [0.4, 1], "active": "any", "one_per_radius_m": 250, "needs": {"shore": true, "open_water": true}, "size_m": 3.5, "color": "#6A5A62", "accent": "#C08088", "speed_mps": 8, "shy_m": 0, "sound": "call", "trophic": "herbivore", "diet": ["grass"], "temperament": "aggressive", "charge_m": 22, "bite": 60, "hp": 220, "hit_parts": {"body": 0.6, "head": 1.0, "eye": 4.0}, "herd_min": 4, "herd_max": 15, "source": "African rivers and lakes; pods lie in the water by day and graze the banks at night; the most dangerous large animal on the continent \u2014 charges anything between it and the water, or near its calves, faster than you can run on land and unstoppable in the water."},
		{"name": "Cape buffalo", "genus": "Syncerus", "species": "caffer", "role": "ground", "body": "quadruped", "spawn": "ambient", "temp_c": [18, 30], "moisture": [0.3, 0.75], "active": "any", "one_per_radius_m": 200, "needs": {"water_within_m": 800}, "size_m": 2.6, "color": "#2A2624", "accent": "#5A4A40", "speed_mps": 9, "shy_m": 0, "sound": "call", "trophic": "herbivore", "diet": ["grass"], "temperament": "aggressive", "charge_m": 18, "bite": 45, "hp": 200, "hit_parts": {"body": 1.0, "head": 0.6, "eye": 4.0}, "herd_min": 8, "herd_max": 40, "source": "African savanna and woodland near water; big herds, old bulls alone in the thickets; charges when approached or wounded and keeps coming \u2014 a wounded buffalo circles back to hunt the hunter. The horn boss shields the head (head hits do less)."},
		{"name": "Wild water buffalo", "genus": "Bubalus", "species": "arnee", "role": "water_edge", "body": "quadruped", "spawn": "ambient", "temp_c": [20, 33], "moisture": [0.55, 1], "active": "any", "one_per_radius_m": 220, "needs": {"shore": true, "water_within_m": 30}, "size_m": 2.8, "color": "#33302E", "accent": "#6A6058", "speed_mps": 8, "shy_m": 0, "sound": "call", "trophic": "herbivore", "diet": ["grass", "reeds"], "temperament": "aggressive", "charge_m": 14, "bite": 40, "hp": 210, "hit_parts": {"body": 1.0, "head": 0.6, "eye": 4.0}, "herd_min": 5, "herd_max": 25, "source": "Wet grassland, swamps and river floodplains of South and SE Asia; wallows by day; the wild ones are as dangerous as the Cape buffalo, charging when crowded or with calves."},
		{"name": "Bull shark", "genus": "Carcharhinus", "species": "leucas", "role": "water_edge", "body": "shark", "spawn": "ambient", "temp_c": [20, 32], "moisture": [0.3, 1], "active": "any", "one_per_radius_m": 160, "needs": {"open_water": true}, "size_m": 2.6, "color": "#6A7078", "accent": "#D8DCD8", "speed_mps": 3.5, "shy_m": 0, "sound": "none", "trophic": "apex", "diet": ["fish", "turtles", "anything"], "temperament": "aggressive", "charge_m": 18, "bite": 34, "hp": 90, "hit_parts": {"body": 1.0, "head": 1.4, "eye": 4.0}, "herd_min": 1, "herd_max": 2, "source": "Warm coasts, estuaries and far up rivers \u2014 the shark that turns up in fresh water (Mississippi, Amazon, Zambezi); the most dangerous to a swimmer in murky water. Salt not required."},
