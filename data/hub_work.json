  "_help_sources": "Where raw materials come from in the hub (§GM.4). each = units taken per trip; count = how many there are in a new hub; regrow = units back per game day; walk = it is out past the camp, the keeper walks there (off_screen_min if none is in reach).",
  "sources": {
    "dead_wood":    {"gives": {"logs": 2}, "count": 12, "regrow_per_day": 3, "tool": "stone_axe", "work_min": 6},
    "game":         {"gives": {"raw_meat": 3, "raw_hide": 1, "sinew": 1, "bone_antler": 1, "teeth": 4}, "count": 6, "regrow_per_day": 1, "tools": ["spear", "bow"], "work_min": 25, "off_screen_min": 40, "off_screen_success": 0.5, "_help": "the hunter stalks a real hub creature when one is in reach (§GF ground life); otherwise he leaves past the camp's edge for off_screen_min and comes back with a kill at off_screen_success x (game left / count)"},
    "fish_trap":    {"gives": {"raw_fish": 1}, "fills_per_day": 2, "max_in_trap": 3, "tool": "fish_trap", "work_min": 3},
    "river_net":    {"gives": {"raw_fish": 2}, "tools": ["dugout", "paddle", "net"], "work_min": 18, "success": 0.7},
