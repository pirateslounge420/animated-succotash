    "gut_dry_fish": {"by": "fisher_weaver", "in": {"raw_fish": 1}, "out": {"dried_fish": 1}, "tool": "flint_blade", "at": "fish_line", "work_min": 2, "wait_min": 90},
    "twist_cord":   {"by": "fisher_weaver", "in": {"fibre": 1}, "out": {"cordage": 1}, "tool": "weaving_frame", "at": "weaving_frame", "work_min": 8},
    "weave_basket": {"by": "fisher_weaver", "in": {"cordage": 2}, "out": {"baskets": 1}, "tool": "weaving_frame", "at": "weaving_frame", "work_min": 15},
    "dry_herbs":    {"by": "forager_herbalist", "in": {"fresh_herbs": 1}, "out": {"dried_herbs": 1}, "at": "herb_rack", "work_min": 2, "wait_min": 120},
    "grind_herbs":  {"by": "forager_herbalist", "in": {"dried_herbs": 2}, "out": {"ground_herbs": 1}, "tool": "mortar_pestle", "at": "mortar_stone", "work_min": 6},
    "coil_pot":     {"by": "knapper_potter", "in": {"clay": 1, "water": 1}, "out": {"green_pots": 1}, "tool": "coiling_board", "at": "drying_plank", "work_min": 12},
    "fire_pots":    {"by": "knapper_potter", "in": {"green_pots": 3}, "out": {"fired_pots": 3}, "at": "kiln", "fuel": 3, "work_min": 5, "wait_min": 120, "_help": "fires up to 3 at once; fires with fewer if the green pots have waited a day; the kiln smokes harder while it burns", "dry_first_min": 144},
