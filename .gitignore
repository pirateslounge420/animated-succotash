# Godot 4+ specific ignores
.godot/
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/

# System/editor-specific
.DS_Store
Thumbs.db
*.swp

# Build output
/build/
/export/

# The walkabout's full frames (tools/walkabout.gd, design §CA): hundreds of
# PNGs per run; the report and the contact sheets are committed.
tools/reference/walkabout/*/*.png
__pycache__/

# Walkabout output (tools/reference/walkabout/run.sh): frames, sheets and the log stay local
/tools/reference/walkabout/*/
/tools/reference/walkabout/sheet_*.png
/tools/reference/walkabout/sheet_*.png.import
/tools/reference/walkabout/walkabout.txt

# The real Earth's source rasters (design §FX, data/earth/README.md): ETOPO, CHELSA and
# RESOLVE downloads are hundreds of MB each. Only the small derived files are committed.
data/earth/sources/
*.tif
*.tiff
*.nc
