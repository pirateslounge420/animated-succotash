+# --- Chapel ---------------------------------------------------------------------
+
+## A field chapel: nave walls of coursed stone with quoins, three
+## round-headed windows a side between buttresses, a steep slate roof, the
+## front gable pierced by an arched door and a round window and topped by
+## a bell cote with its bell and a cross. Inside: a flagged floor, pews
+## either side of an aisle, an altar with candles and a glow. A straight
+## path runs out from the door, a wayside cross at its far end.
+func _chapel() -> void:
+	palette = STONES if site.style != "dry" else FIELDSTONE
+	var hw: float = site.half_w
+	var hl: float = site.half_l
+	var wh: float = site.wall_h
+	var t := 0.7
+	var gr := _ground_range(Vector2.ZERO, maxf(hw, hl))
+	var fy := gr.y + 0.35
+	var y0 := gr.x - 1.2
+	var pitch := deg_to_rad(52.0)
+	var eave := fy + wh
+	var over := 0.45
+	var rise := (hw + over) * tan(pitch)
+	var apex := eave - over * tan(pitch) + rise
+	_mark('The walls, walked round from')
+	# The walls, walked round from the front (outside on the right).
+	var fz := -hl + t * 0.5
+	var bz := hl - t * 0.5
+	var sx := hw - t * 0.5
+	var gable := [Vector2(0.0, eave), Vector2(hw, eave + hw * tan(pitch)), Vector2(2.0 * hw, eave)]
+	var door := hole(hw, 0.85, fy, fy + 2.15)
+	var rose := hole(hw, 0.55, 0.0, eave + 1.3, true)
+	_wall(Vector2(-hw, fz), Vector2(hw, fz), y0, gable, t, [door, rose], 0.55, 1.3, 0.25, fy, 0.35)
+	_voussoirs(Vector2(-hw, fz), Vector2(hw, fz), t, door, 0.38)
+	_voussoirs(Vector2(-hw, fz), Vector2(hw, fz), t, rose, 0.25, 0.07, 0.42, false)
+	var side_len := 2.0 * hl - 2.0 * t
+	var wins: Array = []
+	for k in 3:
+		wins.append(hole(side_len * (k + 0.5) / 3.0, 0.42, fy + 1.55, fy + 3.1))
+	var flat := [Vector2(0.0, eave), Vector2(side_len, eave)]
+	_wall(Vector2(sx, -hl + t), Vector2(sx, hl - t), y0, flat, t, wins, 0.55, 1.3, 0.25, fy, 0.35, false)
+	_wall(Vector2(-sx, hl - t), Vector2(-sx, -hl + t), y0, flat, t, wins, 0.55, 1.3, 0.25, fy, 0.35, false)
+	for w: Dictionary in wins:
+		_voussoirs(Vector2(sx, -hl + t), Vector2(sx, hl - t), t, w, 0.3, 0.07, 0.42, false)
