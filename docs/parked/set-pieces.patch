+func _rotunda() -> void:
+	palette = MARBLE
+	var rr: float = site.ring_r
+	var cols: int = site.columns
+	var ch: float = site.col_h
+	var r1: float = site.plinth_r
+	var r2 := r1 - 0.75
+	var r3 := r2 - 0.75
+	var sh := 0.36
+	var hi := -INF
+	var lo := INF
+	for k in 16:
