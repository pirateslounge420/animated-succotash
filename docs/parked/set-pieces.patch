+## A walkable slope (collision only) from `a` up to `b` (both in the x = 0
+## plane), `w` wide, its surface on the line, run on `ext` m past the foot
+## into the ground. Pieces of a stair meet at their ends with no lip (the
+## RuinBuilder ramp's foot would stand proud of a steeper piece below).
+func _ramp_seg(a: Vector3, b: Vector3, w: float, ext: float) -> void:
+	var dirv := (b - a).normalized()
+	var x := Vector3.RIGHT
+	var nrm := dirv.cross(x)
+	if nrm.y < 0.0:
+		nrm = -nrm
+		x = -x
+	var foot := a - dirv * ext
+	_collision_box(Transform3D(Basis(x, nrm, dirv), (foot + b) * 0.5 - nrm * 0.5), Vector3(w * 0.5, 0.5, foot.distance_to(b) * 0.5))
+
+
+## Flat paving (drawn only) over a rectangle at height y, in tiles about
+## `tile` m, each its own shade.
+func _paving(x0: float, x1: float, z0: float, z1: float, y: float, tile: float) -> void:
+	var nx := maxi(1, int(round((x1 - x0) / tile)))
+	var nz := maxi(1, int(round((z1 - z0) / tile)))
+	for i in nx:
+		for j in nz:
+			var xa := x0 + (x1 - x0) * i / nx
+			var xb := x0 + (x1 - x0) * (i + 1) / nx
+			var za := z0 + (z1 - z0) * j / nz
+			var zb := z0 + (z1 - z0) * (j + 1) / nz
+			var col: Color = (palette[rng.randi() % palette.size()] as Color).lightened(rng.randf_range(-0.05, 0.05)).darkened(shade)
+			var m := _growth(0.15) * rng.randf()
+			col = col.lerp(MOSS, m * 0.4)
+			col.a = m
+			var yy := y + rng.randf_range(-0.01, 0.01)
+			_face4(Vector3(xa, yy, za), Vector3(xb, yy, za), Vector3(xb, yy, zb), Vector3(xa, yy, zb), col, col, col, col, Vector3((xa + xb) * 0.5, yy - 1.0, (za + zb) * 0.5))
+
+
+## A column standing at `p` (on the floor), `h` tall to the top of its
+## abacus, shaft radius `r`: a square plinth, a moulded base, a shaft with
+## entasis and a flared capital under a square abacus. Collision is a box.
+func _column(p: Vector3, h: float, r: float, yaw: float) -> void:
+	var basis := Basis(Vector3.UP, yaw)
+	box(Transform3D(basis, p + Vector3(0.0, 0.15, 0.0)), Vector3(r * 2.7, 0.3, r * 2.7), palette[rng.randi() % palette.size()], _growth(0.4), 0.05, 0.02)
+	var hs := h - 0.3 - 0.36 - 0.2 - 0.36
+	var prof := PackedVector2Array([Vector2(r + 0.14, 0.0), Vector2(r + 0.16, 0.07), Vector2(r + 0.13, 0.15), Vector2(r + 0.05, 0.18),
+		Vector2(r + 0.07, 0.24), Vector2(r + 0.02, 0.3), Vector2(r, 0.36), Vector2(r * 0.99, 0.36 + hs * 0.33),
+		Vector2(r * 0.95, 0.36 + hs * 0.66), Vector2(r * 0.87, 0.36 + hs), Vector2(r * 0.9, 0.4 + hs), Vector2(r * 0.87, 0.44 + hs),
+		Vector2(r * 1.02, 0.52 + hs), Vector2(r * 1.2, 0.62 + hs), Vector2(r * 1.32, 0.72 + hs), Vector2(0.0, 0.72 + hs)])
+	var col: Color = palette[rng.randi() % palette.size()]
+	var was := solid
+	_lathe(Transform3D(basis, p + Vector3(0.0, 0.3, 0.0)), prof, 16, col, _growth(0.35), false, 6)
+	box(Transform3D(basis, p + Vector3(0.0, h - 0.1, 0.0)), Vector3(r * 2.9, 0.2, r * 2.9), palette[rng.randi() % palette.size()], _growth(0.6), 0.04, 0.01)
+	solid = was
+	_collision_box(Transform3D(basis, p + Vector3(0.0, h * 0.5, 0.0)), Vector3(r * 0.95, h * 0.5, r * 0.95))
