+	var crowns: Array[Vector2] = []
+	var x := xa
+	for i in n:
+		crowns.append(Vector2(x + spans[i] * 0.5, spring + spans[i] * 0.5 + 1.15))
+		x += spans[i] + pw
+	var deck: Array[Vector2] = []
+	var ends: Array[Vector2] = [] # the approach ramps' far ends
+	for s: float in [-1.0, 1.0]:
+		var xe := xb if s > 0.0 else xa
+		var ye: float = crowns[n - 1].y if s > 0.0 else crowns[0].y
+		var d := 1.0
