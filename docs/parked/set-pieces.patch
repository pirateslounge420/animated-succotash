+		var up_p: Vector2 = simple[i]
+		var dn: Vector2 = simple[i + 1]
+		_ramp_seg(Vector3(0.0, dn.y, dn.x), Vector3(0.0, up_p.y, up_p.x), w, 0.6 if i == simple.size() - 2 else 0.0)
