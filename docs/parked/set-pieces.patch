+			box(Transform3D(Basis.IDENTITY, Vector3(sx * (w * 0.5 + 0.3), g + 0.5, foot + 0.4)), Vector3(0.9, 1.9, 0.9), palette[1], _growth(0.4), 0.1, 0.03)
+			box(Transform3D(Basis.IDENTITY, Vector3(sx * (w * 0.5 + 0.3), g + 1.5, foot + 0.4)), Vector3(1.1, 0.22, 1.1), palette[0], _growth(0.6), 0.06, 0.02)
+	# The ramp: through the treads' front edges, straight runs merged.
+	var pts: Array[Vector2] = [Vector2(z_top + 0.05, y_top + 0.04)] # (z, y)
+	for i in steps:
+		pts.append(Vector2(z_top - (i + 1) * run, ys[i]))
+	pts.append(Vector2(foot - 0.5, ground(0.0, foot - 0.5) - 0.02))
+	var simple: Array[Vector2] = [pts[0]]
+	for i in range(1, pts.size() - 1):
+		var prev: Vector2 = simple[simple.size() - 1]
+		var s0 := (pts[i].y - prev.y) / (pts[i].x - prev.x)
+		var s1 := (pts[i + 1].y - pts[i].y) / (pts[i + 1].x - pts[i].x)
