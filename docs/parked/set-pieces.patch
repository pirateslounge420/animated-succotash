diff --git a/scripts/landmarks/set_piece_builder.gd b/scripts/landmarks/set_piece_builder.gd
new file mode 100644
index 0000000..aeadd6d
--- /dev/null
+++ b/scripts/landmarks/set_piece_builder.gd
@@ -0,0 +1,1480 @@
+class_name SetPieceBuilder
+extends RuinBuilder
+## Builds the set pieces (SetPieces): a domed rotunda on a knoll, a field
+## chapel, a desert mission and a stone bridge over a river. They stand
+## whole, weathered and mossy, so on top of RuinBuilder's blocks they have
+## shapes of their own:
+##   * turned stone (_lathe): column shafts with entasis, bases and
+##     capitals, domes, drums, bells;
+##   * ashlar walls (_wall): flat faces coursed in block colors, cut by
+##     real round-headed arches and round windows, with reveals, and
+##     gables or any top line; arches are ringed with wedge voussoirs
+##     (_hexa) standing proud of the face;
+##   * roofs of overlapping slab courses, stairs set into the hillside
+##     (_hill_stair) with a smooth ramp standing in for the steps.
+## Collision and the far LOD take the walls without their coursing, the
+## columns as boxes and the domes at a lower resolution.
+
+## Pale, fine-grained stone for the rotunda (no brighter than the pale
+## limestone: brighter albedo blooms in full sun and by firelight).
+const MARBLE := [Color(0.6, 0.58, 0.53), Color(0.56, 0.55, 0.51), Color(0.62, 0.6, 0.55), Color(0.53, 0.52, 0.49), Color(0.58, 0.56, 0.5)]
+## Warm grey fieldstone for chapels in dry country.
+const FIELDSTONE := [Color(0.5, 0.47, 0.41), Color(0.46, 0.44, 0.39), Color(0.54, 0.5, 0.43), Color(0.43, 0.41, 0.37), Color(0.49, 0.46, 0.4)]
+const SLATE := [Color(0.3, 0.33, 0.37), Color(0.27, 0.3, 0.34), Color(0.33, 0.35, 0.38), Color(0.29, 0.31, 0.33)]
+const TERRACOTTA := [Color(0.6, 0.33, 0.22), Color(0.55, 0.3, 0.2), Color(0.64, 0.37, 0.25), Color(0.5, 0.28, 0.19)]
+const BRONZE := Color(0.5, 0.4, 0.2)
+const DOOR_WOOD := Color(0.34, 0.24, 0.16)
+## Lamp-gold (a chapel's or mission's altar) and moss-teal glows.
+const LAMP := Color(1.0, 0.72, 0.4)
+const TEAL := Color(0.45, 0.85, 0.8)
+static var debug := false
+var _mark_at := 0
+
+
+func _mark(label: String) -> void:
+	if debug:
+		print("   %s: %d" % [label, (_v.size() - _mark_at) / 3])
+	_mark_at = _v.size()
+
+
+func _set_piece() -> void:
+	match int(site.kind):
+		Ruins.Kind.ROTUNDA:
+			_rotunda()
+		Ruins.Kind.CHAPEL:
+			_chapel()
+		Ruins.Kind.MISSION:
+			_mission()
+		Ruins.Kind.BRIDGE:
+			_bridge()
+	_front_faces(_v, _n, _c, _m)
+	_front_faces(_lv, _ln, _lc, _lm)
+
+
+## Rewind every triangle clockwise seen from outside, the way Godot takes
+## front faces. The primitives draw them the other way round, so with
+## culling off Godot shades them as back faces, their normals flipped:
+## under an omni light (a camp's fire, a lamp) the ruin shader's rim term,
+## which has no falloff, then floods whole flat faces white. (The ruins
+## keep the old winding, and their look, as they are.)
+func _front_faces(v: PackedVector3Array, n: PackedVector3Array, c: PackedColorArray, m: PackedVector2Array) -> void:
+	for t in range(0, v.size(), 3):
+		var pv := v[t + 1]
+		v[t + 1] = v[t + 2]
+		v[t + 2] = pv
+		var pn := n[t + 1]
+		n[t + 1] = n[t + 2]
+		n[t + 2] = pn
+		var pc := c[t + 1]
+		c[t + 1] = c[t + 2]
+		c[t + 2] = pc
+		var pm := m[t + 1]
+		m[t + 1] = m[t + 2]
+		m[t + 2] = pm
+
+
+# --- Primitives ----------------------------------------------------------------
+
+## Copy what was drawn since `start` into the far LOD.
+func _lod_since(start: int) -> void:
+	_lv.append_array(_v.slice(start))
+	_ln.append_array(_n.slice(start))
+	_lc.append_array(_c.slice(start))
+	_lm.append_array(_m.slice(start))
+
+
+## Drop what was drawn since `start`.
+func _undraw(start: int) -> void:
+	_v.resize(start)
+	_n.resize(start)
+	_c.resize(start)
+	_m.resize(start)
+
+
+## A flat quad (corners in order round it) with a color per corner, facing
+## away from `inside`.
+func _face4(a: Vector3, b: Vector3, c: Vector3, d: Vector3, ca: Color, cb: Color, cc: Color, cd: Color, inside: Vector3) -> void:
+	var nrm := (b - a).cross(c - a) + (c - a).cross(d - a)
+	if nrm.length_squared() < 1e-10:
+		return
+	nrm = nrm.normalized()
+	if nrm.dot((a + b + c + d) * 0.25 - inside) < 0.0:
+		nrm = -nrm
+	if (b - a).cross(c - a).length_squared() > 1e-10:
+		_tri_n(a, b, c, nrm, nrm, nrm, ca, cb, cc, inside)
+	if (c - a).cross(d - a).length_squared() > 1e-10:
+		_tri_n(a, c, d, nrm, nrm, nrm, ca, cc, cd, inside)
+
+
+## A collision triangle, solid from the side `out` points to.
+func _ctri(a: Vector3, b: Vector3, c: Vector3, out: Vector3) -> void:
+	if (b - a).cross(c - a).dot(out) > 0.0:
+		_cv.append_array([a, c, b])
+	else:
+		_cv.append_array([a, b, c])
+
+
+## A six-sided block from its 8 corners (index bits: 1 = +x, 2 = +y,
+## 4 = +z, in whatever frame the corners were made in: voussoirs, wedges,
+## sloping parapet stones). The +y face takes the moss.
+func _hexa(p: Array, col: Color, moss: float, lod := true) -> void:
+	col = col.darkened(shade)
+	var top := col.lerp(MOSS, moss)
+	top.a = moss
+	var side := col.lerp(MOSS, moss * 0.3)
+	side.a = moss * 0.4
+	var bottom := col.darkened(0.3)
+	bottom.a = 0.0
+	var inside := Vector3.ZERO
+	for q in p:
+		inside += q
+	inside /= 8.0
+	var start := _v.size()
+	for f in [[0, 1, 3, 2, side], [4, 5, 7, 6, side], [0, 1, 5, 4, bottom], [2, 3, 7, 6, top], [0, 2, 6, 4, side], [1, 3, 7, 5, side]]:
+		var c: Color = f[4]
+		_face4(p[f[0]], p[f[1]], p[f[2]], p[f[3]], c, c, c, c, inside)
+	if solid:
+		_collide_since(start)
+	if lod:
+		_lod_since(start)
+
+
+## A plain six-sided slab (12 triangles, no bevel): furniture and the
+## like, not in the far LOD.
+func _slab(xf: Transform3D, size: Vector3, col: Color) -> void:
+	var p: Array = []
+	for i in 8:
+		p.append(xf * (Vector3(0.5 if i & 1 else -0.5, 0.5 if i & 2 else -0.5, 0.5 if i & 4 else -0.5) * size))
+	_hexa(p, col, 0.0, false)
+
+
+## A surface of revolution round `xf`'s y axis: `prof` is (radius, height)
+## from bottom to top, the outside on the right of the line walked up
+## (so a closed loop walked that way makes a solid ring). Smooth round the
+## axis; along the profile each segment keeps its own normal, unless
+## `smooth` (domes, bells). Moss on the upward faces. `lod_sides` > 0 adds
+## a coarser copy to the far LOD. `inward` flips it to be seen from within
+## (a dome's ceiling).
+func _lathe(xf: Transform3D, prof: PackedVector2Array, sides: int, col: Color, moss: float, smooth := false, lod_sides := 0, inward := false) -> void:
+	_lathe_pass(xf, prof, sides, col, moss, smooth, inward)
+	if lod_sides > 0:
+		var start := _v.size()
+		_lathe_pass(xf, prof, lod_sides, col, moss, false, inward)
+		_lod_since(start)
+		_undraw(start)
+
+
+func _lathe_pass(xf: Transform3D, prof: PackedVector2Array, sides: int, col: Color, moss: float, smooth: bool, inward: bool) -> void:
+	col = col.darkened(shade)
+	var n := prof.size()
+	var sn: Array[Vector2] = []
+	for k in n - 1:
+		var d := prof[k + 1] - prof[k]
+		var nn := Vector2(d.y, -d.x).normalized()
+		sn.append(-nn if inward else nn)
+	# Normal (2D) at profile point k of segment `seg`.
+	var pn := func(k: int, seg: int) -> Vector2:
+		if not smooth:
+			return sn[seg]
+		var acc := Vector2.ZERO
+		if k > 0:
+			acc += sn[k - 1]
+		if k < n - 1:
+			acc += sn[k]
+		return acc.normalized() if acc.length_squared() > 1e-8 else sn[seg]
+	var cs := PackedFloat32Array()
+	var ss := PackedFloat32Array()
+	for i in sides + 1:
+		cs.append(cos(TAU * i / sides))
+		ss.append(sin(TAU * i / sides))
+	for k in n - 1:
+		var p0 := prof[k]
+		var p1 := prof[k + 1]
+		if p0.x < 1e-4 and p1.x < 1e-4:
+			continue
+		var n0: Vector2 = pn.call(k, k)
+		var n1: Vector2 = pn.call(k + 1, k)
+		for i in sides:
+			var pts: Array[Vector3] = []
+			var nrs: Array[Vector3] = []
+			var cols: Array[Color] = []
+			for q in [[p0, n0, i], [p0, n0, i + 1], [p1, n1, i + 1], [p1, n1, i]]:
+				var pp: Vector2 = q[0]
+				var nv: Vector2 = q[1]
+				var j: int = q[2]
+				pts.append(xf * Vector3(pp.x * cs[j], pp.y, pp.x * ss[j]))
+				var w := (xf.basis * Vector3(nv.x * cs[j], nv.y, nv.x * ss[j])).normalized()
+				nrs.append(w)
+				var m := moss * smoothstep(0.1, 0.7, w.y)
+				var c := col.lerp(MOSS, m)
+				c.a = m
+				cols.append(c)
+			var mid := (pts[0] + pts[2]) * 0.5
+			var inside := mid - (nrs[0] + nrs[2]).normalized() * 0.5
+			if (pts[1] - pts[0]).length_squared() > 1e-10:
+				_tri_n(pts[0], pts[1], pts[2], nrs[0], nrs[1], nrs[2], cols[0], cols[1], cols[2], inside)
+			if (pts[2] - pts[3]).length_squared() > 1e-10:
+				_tri_n(pts[0], pts[2], pts[3], nrs[0], nrs[2], nrs[3], cols[0], cols[2], cols[3], inside)
+
+
+## Collision for the top of a disc (a round floor) of radius `r` at y.
+func _disc_collision(c: Vector3, r: float, sides: int) -> void:
+	for i in sides:
+		var a0 := TAU * i / sides
+		var a1 := TAU * (i + 1) / sides
+		_ctri(c, c + Vector3(cos(a0), 0.0, sin(a0)) * r, c + Vector3(cos(a1), 0.0, sin(a1)) * r, Vector3.UP)
+
+
+## Mortar-free ashlar: which block (a key for its color) covers `u` along
+## a wall in course `course`, joints staggered course to course.
+func _ashlar_key(u: float, course: int, bl: float, wid: int) -> int:
+	var block := int(floor(u / bl + (0.5 if course % 2 == 1 else 0.0)))
+	return hash(Vector3i(wid, course, block))
+
+
+func _ashlar_col(key: int) -> Color:
+	var col: Color = palette[posmod(key, palette.size())]
+	return col.lightened(float(posmod(key >> 8, 100)) / 100.0 * 0.12 - 0.06)
+
+
+## A hole in a wall (`_wall`): centered `u` m along it, `hw` half wide;
+## round-headed from `sill` up to the springing at `spring` (then a
+## semicircle), or with `round` a circle of radius hw round `spring`.
+static func hole(u: float, hw: float, sill: float, spring: float, round := false) -> Dictionary:
+	return {"u": u, "hw": hw, "sill": sill, "spring": spring, "round": round}
+
+
+func _hole_lo(h: Dictionary, u: float) -> float:
+	if h.round:
+		return h.spring - sqrt(maxf(h.hw * h.hw - (u - h.u) * (u - h.u), 0.0))
+	return h.sill
+
+
+func _hole_hi(h: Dictionary, u: float) -> float:
+	return h.spring + sqrt(maxf(h.hw * h.hw - (u - h.u) * (u - h.u), 0.0))
+
+
+## A straight wall of dressed stone from a to b (local xz), `thick` thick,
+## from `y0` (down in the ground) up to the line `tops` ([Vector2(u, y)],
+## u along the wall from a; a gable is three points). Holes (hole()) are
+## cut right through with reveals round them. The outer face (side +1, on
+## the right walking a to b) is coursed `ch` high in blocks `bl` long by
+## color alone, joints staggered, darker toward the ground (and a floor at
+## `ao_floor`, if higher); the back face too, unless it's an interior
+## (`back_shade` > 0: plain, darkened by that much), and it's left out
+## below `back_from`. Collision and the far LOD get the faces uncoursed.
+func _wall(a: Vector2, b: Vector2, y0: float, tops: Array, thick: float, holes: Array, ch := 0.6, bl := 1.3,
+		moss := 0.2, back_from := -INF, back_shade := 0.0, caps := true) -> void:
+	var length := a.distance_to(b)
+	if length < 0.05:
+		return
+	var us := PackedFloat32Array([0.0, length])
+	var nb := int(ceil(length / (bl * 0.5)))
+	for i in range(1, nb):
+		us.append(length * i / nb)
+	for t: Vector2 in tops:
+		us.append(t.x)
+	for h: Dictionary in holes:
+		var segs := 16 if h.round else 10
+		for k in segs + 1:
+			us.append(h.u - h.hw + 2.0 * h.hw * k / segs)
+	us.sort()
+	var cuts := PackedFloat32Array()
+	for u in us:
+		if u < -0.001 or u > length + 0.001:
+			continue
+		if cuts.is_empty() or u - cuts[cuts.size() - 1] > 0.02:
+			cuts.append(clampf(u, 0.0, length))
+	cuts[cuts.size() - 1] = length
+	var wid := rng.randi()
+	var start := _v.size()
+	_wall_pass(a, b, y0, tops, thick, holes, cuts, 0.0, bl, moss, back_from, back_shade, caps, wid)
+	_collide_since(start)
+	_lod_since(start)
+	if ch > 0.0:
+		_undraw(start)
+		_wall_pass(a, b, y0, tops, thick, holes, cuts, ch, bl, moss, back_from, back_shade, caps, wid)
+
+
+## A floor inside walls (AO darkens toward it as toward the ground).
+var ao_floor := -INF
+
+
+func _top_at(tops: Array, u: float) -> float:
+	var prev: Vector2 = tops[0]
+	if u <= prev.x:
+		return prev.y
+	for i in range(1, tops.size()):
+		var t: Vector2 = tops[i]
+		if u <= t.x:
+			return lerpf(prev.y, t.y, (u - prev.x) / maxf(t.x - prev.x, 1e-5))
+		prev = t
+	return prev.y
+
+
+func _wall_pass(a: Vector2, b: Vector2, y0: float, tops: Array, thick: float, holes: Array, cuts: PackedFloat32Array,
+		ch: float, bl: float, moss: float, back_from: float, back_shade: float, caps: bool, wid: int) -> void:
+	var length := a.distance_to(b)
+	var d2 := (b - a) / length
+	var dir := Vector3(d2.x, 0.0, d2.y)
+	var nrm := Vector3(d2.y, 0.0, -d2.x)
+	var o := Vector3(a.x, 0.0, a.y)
+	var ht := thick * 0.5
+	var top_col: Color = (palette[0] as Color).darkened(shade)
+	var mtop := _growth(moss * 2.0)
+	var top_c := top_col.lerp(MOSS, mtop)
+	top_c.a = mtop
+	var rev: Color = (palette[3 % palette.size()] as Color).darkened(0.12 + shade)
+	# Course bands whole across a strip, gathered to be merged along the
+	# wall: [side, course] -> [[u0, u1, y0, y1, key, g], ...].
+	var bands := {}
+	for i in cuts.size() - 1:
+		var u0 := cuts[i]
+		var u1 := cuts[i + 1]
+		var um := (u0 + u1) * 0.5
+		var pm := o + dir * um
+		var g := maxf(ground(pm.x, pm.z), ao_floor)
+		var t0 := _top_at(tops, u0)
+		var t1 := _top_at(tops, u1)
+		# The holes this strip crosses, bottom up: solid between them.
+		var cut: Array = [] # [lo0, lo1, hi0, hi1]
+		for h: Dictionary in holes:
+			if absf(um - h.u) < h.hw:
+				cut.append([_hole_lo(h, u0), _hole_lo(h, u1), _hole_hi(h, u0), _hole_hi(h, u1)])
+		cut.sort_custom(func(p, q): return p[0] + p[1] < q[0] + q[1])
+		var spans: Array = [] # [bottom0, bottom1, top0, top1]
+		var c0 := y0
+		var c1 := y0
+		for hc in cut:
+			var lo0: float = hc[0]
+			var lo1: float = hc[1]
+			if maxf(lo0, lo1) > maxf(c0, c1) + 0.01:
+				spans.append([c0, c1, lo0, lo1])
+				var inside := pm + Vector3(0.0, (lo0 + lo1) * 0.5 - 0.3, 0.0)
+				_face4(o + dir * u0 + nrm * ht + Vector3(0, lo0, 0), o + dir * u1 + nrm * ht + Vector3(0, lo1, 0),
+					o + dir * u1 - nrm * ht + Vector3(0, lo1, 0), o + dir * u0 - nrm * ht + Vector3(0, lo0, 0), rev, rev, rev, rev, inside)
+			var h0 := minf(hc[2], t0)
+			var h1 := minf(hc[3], t1)
+			if h0 < t0 - 0.01 or h1 < t1 - 0.01:
+				var inside := pm + Vector3(0.0, (h0 + h1) * 0.5 + 0.3, 0.0)
+				_face4(o + dir * u0 + nrm * ht + Vector3(0, h0, 0), o + dir * u1 + nrm * ht + Vector3(0, h1, 0),
+					o + dir * u1 - nrm * ht + Vector3(0, h1, 0), o + dir * u0 - nrm * ht + Vector3(0, h0, 0), rev, rev, rev, rev, inside)
+			c0 = h0
+			c1 = h1
+		if c0 < t0 - 0.01 or c1 < t1 - 0.01:
+			spans.append([c0, c1, t0, t1])
+		for sp in spans:
+			for s: float in [1.0, -1.0]:
+				var b0: float = sp[0]
+				var b1: float = sp[1]
+				if s < 0.0 and back_from > -INF:
+					b0 = maxf(b0, back_from)
+					b1 = maxf(b1, back_from)
+					if b0 >= sp[2] - 0.01 and b1 >= sp[3] - 0.01:
+						continue
+				var interior := s < 0.0 and back_shade > 0.0
+				_wall_face(o, dir, nrm * (s * ht), pm - nrm * (s * ht), u0, u1, b0, b1, sp[2], sp[3], g,
+					0.0 if interior else ch, bl, wid, (back_shade if interior else 0.0) + shade, moss, bands, s)
+		# The top.
+		_face4(o + dir * u0 + nrm * ht + Vector3(0, t0, 0), o + dir * u1 + nrm * ht + Vector3(0, t1, 0),
+			o + dir * u1 - nrm * ht + Vector3(0, t1, 0), o + dir * u0 - nrm * ht + Vector3(0, t0, 0), top_c, top_c, top_c, top_c,
+			pm + Vector3(0.0, (t0 + t1) * 0.5 - 0.3, 0.0))
+	# The whole course bands, runs in one block merged.
+	for key in bands:
+		var s: float = key.x
+		var off := nrm * (s * ht)
+		var run: Array = bands[key]
+		run.sort_custom(func(p, q): return p[0] < q[0])
+		var j := 0
+		while j < run.size():
+			var first: Array = run[j]
+			var last: Array = first
+			while j + 1 < run.size():
+				var nx: Array = run[j + 1]
+				if absf(nx[0] - last[1]) > 0.001 or nx[4] != first[4] or absf(nx[2] - first[2]) > 0.001 or absf(nx[3] - first[3]) > 0.001:
+					break
+				last = nx
+				j += 1
+			j += 1
+			var ua: float = first[0]
+			var ub: float = last[1]
+			var ya: float = first[2]
+			var yb: float = first[3]
+			var c := _ashlar_col(first[4])
+			var dark := shade
+			var pa := o + dir * ua + off
+			var pb := o + dir * ub + off
+			_face4(pa + Vector3(0, ya, 0), pb + Vector3(0, ya, 0), pb + Vector3(0, yb, 0), pa + Vector3(0, yb, 0),
+				_wall_col(ya, first[5], c, dark, moss), _wall_col(ya, last[5], c, dark, moss), _wall_col(yb, last[5], c, dark, moss), _wall_col(yb, first[5], c, dark, moss),
+				o + dir * ((ua + ub) * 0.5) - off)
+	# Jambs of round-headed holes, up to the springing.
+	for h: Dictionary in holes:
+		if h.round:
+			continue
+		for s: float in [-1.0, 1.0]:
+			var u: float = h.u + s * h.hw
+			if u <= 0.001 or u >= length - 0.001:
+				continue
+			var top := minf(h.spring, _top_at(tops, u))
+			var lo: float = maxf(h.sill, y0)
+			if top <= lo:
+				continue
+			var p := o + dir * u
+			_face4(p + nrm * ht + Vector3(0, lo, 0), p + nrm * ht + Vector3(0, top, 0), p - nrm * ht + Vector3(0, top, 0),
+				p - nrm * ht + Vector3(0, lo, 0), rev, rev, rev, rev, p + dir * (s * 0.3) + Vector3(0, (lo + top) * 0.5, 0))
+	if caps:
+		for e in [[0.0, -1.0], [length, 1.0]]:
+			var u: float = e[0]
+			var p := o + dir * u
+			var top := _top_at(tops, u)
+			_face4(p + nrm * ht + Vector3(0, y0, 0), p + nrm * ht + Vector3(0, top, 0), p - nrm * ht + Vector3(0, top, 0),
+				p - nrm * ht + Vector3(0, y0, 0), rev, rev, rev, rev, p - dir * (float(e[1]) * 0.3) + Vector3(0, (y0 + top) * 0.5, 0))
+
+
+## A wall's color at height y over ground (or floor) g: darker toward it,
+## a little moss low down.
+func _wall_col(y: float, g: float, base: Color, dark: float, moss: float) -> Color:
+	var c := base.darkened(0.4 * exp(-maxf(y - g, 0.0) / 1.3) + dark)
+	var m := _growth(moss) * (0.3 + 0.5 * exp(-maxf(y - g, 0.0) / 1.5))
+	c = c.lerp(MOSS, m * 0.35)
+	c.a = m * 0.5
+	return c
+
+
+## One face of a wall strip from u0 to u1, bottom b0..b1, top e0..e1,
+## offset `off` from the wall's middle, coursed `ch` high (0: one quad).
+## Course bands whole across the strip go to `bands` (merged later).
+func _wall_face(o: Vector3, dir: Vector3, off: Vector3, inside: Vector3, u0: float, u1: float, b0: float, b1: float,
+		e0: float, e1: float, g: float, ch: float, bl: float, wid: int, dark: float, moss: float, bands: Dictionary, side: float) -> void:
+	var p0 := o + dir * u0 + off
+	var p1 := o + dir * u1 + off
+	var um := (u0 + u1) * 0.5
+	if ch <= 0.0:
+		var base: Color = palette[0]
+		_face4(p0 + Vector3(0, b0, 0), p1 + Vector3(0, b1, 0), p1 + Vector3(0, e1, 0), p0 + Vector3(0, e0, 0),
+			_wall_col(b0, g, base, dark, moss), _wall_col(b1, g, base, dark, moss), _wall_col(e1, g, base, dark, moss), _wall_col(e0, g, base, dark, moss), inside)
+		return
+	# The sloping bottom and top edges keep pieces of their own; the
+	# rectangle between is cut at the course lines (one piece below the
+	# ground).
+	var lo := maxf(b0, b1)
+	var hi := minf(e0, e1)
+	if hi < lo:
+		var c := _ashlar_col(_ashlar_key(um, int(floor((b0 + e0) * 0.5 / ch)), bl, wid))
+		_face4(p0 + Vector3(0, b0, 0), p1 + Vector3(0, b1, 0), p1 + Vector3(0, e1, 0), p0 + Vector3(0, e0, 0),
+			_wall_col(b0, g, c, dark, moss), _wall_col(b1, g, c, dark, moss), _wall_col(e1, g, c, dark, moss), _wall_col(e0, g, c, dark, moss), inside)
+		return
+	if lo - minf(b0, b1) > 0.01:
+		var c := _ashlar_col(_ashlar_key(um, int(floor(lo / ch)), bl, wid))
+		_face4(p0 + Vector3(0, b0, 0), p1 + Vector3(0, b1, 0), p1 + Vector3(0, lo, 0), p0 + Vector3(0, lo, 0),
+			_wall_col(b0, g, c, dark, moss), _wall_col(b1, g, c, dark, moss), _wall_col(lo, g, c, dark, moss), _wall_col(lo, g, c, dark, moss), inside)
+	var y := lo
+	var buried := g - 0.4
+	if y < buried:
+		var yb := minf(buried, hi)
+		var c := _ashlar_col(_ashlar_key(um, int(floor(y / ch)), bl, wid))
+		_face4(p0 + Vector3(0, y, 0), p1 + Vector3(0, y, 0), p1 + Vector3(0, yb, 0), p0 + Vector3(0, yb, 0),
+			_wall_col(y, g, c, dark, moss), _wall_col(y, g, c, dark, moss), _wall_col(yb, g, c, dark, moss), _wall_col(yb, g, c, dark, moss), inside)
+		y = yb
+	while y < hi - 0.01:
+		var k := int(floor(y / ch + 1e-4))
+		var yn := minf((k + 1) * ch, hi)
+		var bk := Vector2i(int(side), k)
+		if not bands.has(bk):
+			bands[bk] = []
+		(bands[bk] as Array).append([u0, u1, y, yn, _ashlar_key(um, k, bl, wid), g])
+		y = yn
+	if maxf(e0, e1) - hi > 0.01:
+		var c := _ashlar_col(_ashlar_key(um, int(floor(hi / ch)), bl, wid))
+		_face4(p0 + Vector3(0, hi, 0), p1 + Vector3(0, hi, 0), p1 + Vector3(0, e1, 0), p0 + Vector3(0, e0, 0),
+			_wall_col(hi, g, c, dark, moss), _wall_col(hi, g, c, dark, moss), _wall_col(e1, g, c, dark, moss), _wall_col(e0, g, c, dark, moss), inside)
+
+
+## Wedge stones about `stone` m long round a hole in the wall from a to b
+## (on both faces, or the outer one only, standing `proud` m out of them),
+## `depth` deep radially; the keystone bigger. Round holes get a full ring.
+func _voussoirs(a: Vector2, b: Vector2, thick: float, h: Dictionary, depth := 0.35, proud := 0.07, stone := 0.42, both := true) -> void:
+	var d2 := (b - a).normalized()
+	var dir := Vector3(d2.x, 0.0, d2.y)
+	var nrm := Vector3(d2.y, 0.0, -d2.x)
+	var c := Vector3(a.x, h.spring, a.y) + dir * float(h.u)
+	var r: float = h.hw
+	var arc := TAU if h.round else PI
+	var n := maxi(5, int(round(arc * r / stone)))
+	if not h.round and n % 2 == 0:
+		n += 1
+	var was := solid
+	solid = false
+	for s: float in ([-1.0, 1.0] if both else [1.0]):
+		var z0 := s * (thick * 0.5 - 0.03)
+		var z1 := s * (thick * 0.5 + proud)
+		for k in n:
+			var th0 := arc * k / n
+			var th1 := arc * (k + 1) / n
+			var key: bool = not h.round and k == n / 2
+			var ro := r + depth + (0.14 if key else 0.0)
+			var zz := z1 + (s * 0.04 if key else 0.0)
+			var p: Array = []
+			for i in 8:
+				var th := th1 if i & 1 else th0
+				var rr := ro if i & 2 else r
+				var z := zz if i & 4 else z0
+				p.append(c + dir * (cos(th) * rr) + Vector3.UP * (sin(th) * rr) + nrm * z)
+			var col: Color = (palette[rng.randi() % palette.size()] as Color).lightened(rng.randf_range(0.0, 0.06))
+			_hexa(p, col, _growth(0.25), false)
+	solid = was
+
+
+## A roof of `rows` overlapping slab courses a side, pitched `pitch` from
+## a ridge along z at height `ridge` over x = cx, reaching `hx` either side
+## (the eaves), from z0 to z1. A ridge cap on top.
+func _gable_roof(cx: float, ridge: float, hx: float, z0: float, z1: float, pitch: float, rows: int, tiles: Array) -> void:
+	var slope := hx / cos(pitch)
+	var step := slope / rows
+	for sx: float in [-1.0, 1.0]:
+		for k in rows:
+			# Each course a little steeper than the roof, so its foot sits
+			# proud of the course below it.
+			var s_mid := slope - (k + 0.5) * step
+			var p := Vector3(cx + sx * s_mid * cos(pitch), ridge - s_mid * sin(pitch), (z0 + z1) * 0.5)
+			var tilt := pitch + 0.035
+			var basis := Basis(Vector3(0, 0, 1), -sx * tilt)
+			p += basis * Vector3(0.0, 0.09, 0.0)
+			var col: Color = (tiles[rng.randi() % tiles.size()] as Color).lightened(rng.randf_range(-0.04, 0.04))
+			box(Transform3D(basis, p), Vector3(step + 0.22, 0.16, z1 - z0), col, _growth(0.35 + 0.25 * float(k == 0)), 0.05, 0.02)
+	box(Transform3D(Basis.IDENTITY, Vector3(cx, ridge + 0.14, (z0 + z1) * 0.5)), Vector3(0.42, 0.3, z1 - z0 + 0.1), (tiles[0] as Color).darkened(0.1), _growth(0.5), 0.1, 0.02)
+
+
+## A bell hanging with its crown at `top` (lathe, open underneath).
+func _bell(top: Vector3, r: float) -> void:
+	var prof := PackedVector2Array([Vector2(r * 1.05, -r * 1.9), Vector2(r, -r * 1.78), Vector2(r * 0.78, -r * 1.3),
+		Vector2(r * 0.66, -r * 0.7), Vector2(r * 0.6, -r * 0.3), Vector2(r * 0.42, -r * 0.06), Vector2(0.0, 0.0)])
+	_lathe(Transform3D(Basis.IDENTITY, top), prof, 12, BRONZE, 0.0, true)
+	_tri_box(Transform3D(Basis.IDENTITY, top + Vector3(0.0, 0.12, 0.0)), Vector3(0.08, 0.24, 0.08), OLD_WOOD)
+
+
+## A stone cross standing at `p` (its foot), `h` tall, facing along z.
+func _cross(p: Vector3, h: float, t: float, col: Color) -> void:
+	box(Transform3D(Basis.IDENTITY, p + Vector3(0.0, h * 0.5, 0.0)), Vector3(t, h, t), col, _growth(0.3), t * 0.15, 0.01)
+	box(Transform3D(Basis.IDENTITY, p + Vector3(0.0, h * 0.7, 0.0)), Vector3(h * 0.55, t, t), col, _growth(0.3), t * 0.15, 0.01)
+
+
+## A broad straight stair down the slope toward -z from a floor at
+## (z_top, y_top), `w` wide, about `length` m long (longer if it hasn't
+## reached the ground by then): steps a riser down each tread until they
+## meet the ground, then set into it and following it down (treads at one
+## height make landings), each on a footing. Cheek
+## walls either side, newels at the foot, and a smooth ramp (collision)
+## standing in for the steps. Returns the foot's z.
+func _hill_stair(w: float, z_top: float, y_top: float, length: float, run := 0.6, riser := 0.3) -> float:
+	var n := int(length / run)
+	var ys: Array[float] = []
+	var lows: Array[float] = []
+	var y := y_top
+	for i in n * 3:
+		var z0 := z_top - (i + 1) * run
+		var z1 := z_top - i * run
+		var gmax := -INF
+		var gmin := INF
+		for sx: float in [-0.5, 0.0, 0.5]:
+			for zz: float in [z0, z1]:
+				var gg := ground(sx * w, zz)
+				gmax = maxf(gmax, gg)
+				gmin = minf(gmin, gg)
+		if i >= n and y < gmax + 0.3:
+			break # long enough, and down on the ground
+		var want := maxf(y - riser, gmax + 0.12)
+		if want > y + 0.02:
+			break # the ground rises again
+		if y - want < 0.1 and i > 0:
+			want = y
+		y = minf(want, y)
+		ys.append(y)
+		lows.append(gmin)
+	var steps := ys.size()
+	var was := solid
+	solid = false
+	for i in steps:
+		var z0 := z_top - (i + 1) * run
+		var z1 := z_top - i * run + 0.3
