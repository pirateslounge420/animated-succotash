+	var ye := y3 + ch
+	var ri := rr - 0.5
+	var ro := rr + 0.5
+	var ent := PackedVector2Array([Vector2(ri, ye), Vector2(ro, ye), Vector2(ro, ye + 0.5), Vector2(ro - 0.07, ye + 0.52),
