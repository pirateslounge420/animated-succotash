+class_name SetPieces
+## Where the set pieces stand: whole buildings of the old civilization,
+## weathered and mossy but standing, the architecture the references are
+## built round (Ruins finds them, SetPieceBuilder builds them):
+##   * a rotunda: a domed ring of columns on a stepped plinth on a knoll,
+##     a broad stair climbing to it past fallen stones (temperate and dry
+##     grass country);
+##   * a chapel: steep gabled roof, a bell cote on the front gable, arched
+##     door and windows, at the end of a straight path across open ground
+##     (temperate and dry country); you can walk in;
+##   * a mission: a sandstone church with two domed bell towers and a
+##     curved gable, on a terrace on a rise with a grand stair up to it
+##     (desert and dry country); you can walk in;
+##   * a bridge: stone arches on piers across a real river (any land but
+##     snow and marsh), a walkable deck between parapets.
+##
+## They take Ruins grid cells that hold no ruin (Ruins.find() rolls those
+## first, with the cell's own numbers), each on random streams of its own,
+## so every ruin stays just where and what it was.
+
+const TEMPERATE := [BiomeTemplates.TEMPERATE_DECIDUOUS, BiomeTemplates.TEMPERATE_RAINFOREST,
+	BiomeTemplates.TAIGA, BiomeTemplates.KRUMMHOLZ, BiomeTemplates.TALLGRASS_PRAIRIE, BiomeTemplates.WET_MEADOW,
+	BiomeTemplates.ALPINE_MEADOW, BiomeTemplates.PARAMO, BiomeTemplates.FLOODPLAIN_FOREST, BiomeTemplates.MARITIME_FOREST]
+const DRY := [BiomeTemplates.MEDITERRANEAN_SCRUB, BiomeTemplates.STEPPE, BiomeTemplates.SHORTGRASS_PRAIRIE,
+	BiomeTemplates.SAGEBRUSH, BiomeTemplates.SAVANNA, BiomeTemplates.THORN_SCRUB, BiomeTemplates.TROPICAL_DRY_FOREST,
+	BiomeTemplates.PUNA]
+## Share of the empty cells holding [a rotunda, a chapel, a mission], by
+## setting().
+const CHANCE := {"temperate": [0.14, 0.16, 0.0], "dry": [0.1, 0.1, 0.14], "desert": [0.0, 0.0, 0.22]}
+## Share of the empty cells with a river reach fit to bridge that get a
+## bridge (any setting but snow and marsh).
+const BRIDGE_CHANCE := 0.85
+const BRIDGE_MAX_W := 50.0
+## The most the river may fall along the reach (so no tall falls).
+const BRIDGE_MAX_DROP := 16.0
+const NAMES := {Ruins.Kind.ROTUNDA: "Hilltop rotunda", Ruins.Kind.CHAPEL: "Field chapel",
+	Ruins.Kind.MISSION: "Desert mission", Ruins.Kind.BRIDGE: "Old bridge"}
+
+
+## The kind of land for a set piece at `p`: "temperate", "dry", "desert",
+## "jungle" or "" (anything else: shores, volcanic fields, snow, marsh).
+static func setting(map: PlanetData, p: Vector3) -> String:
+	var land := Ruins.country(map, p)
+	if land == "jungle":
+		return "jungle"
+	if land != "":
+		return ""
+	var b := map.biome[map.cell_at(p)]
+	if b in Ruins.DESERTY:
+		return "desert"
+	if b in DRY:
+		return "dry"
+	if b in TEMPERATE:
+		return "temperate"
+	return ""
+
+
+static func site_name(site: Dictionary) -> String:
+	if int(site.kind) == Ruins.Kind.MISSION and site.style != "desert":
+		return "Old mission"
+	return NAMES[int(site.kind)]
+
+
+## The set piece in an empty Ruins cell `c` (key: its Ruins key), or {}.
+## Same fields as Ruins.find(), and each kind's measurements (see below).
+static func find(map: PlanetData, c: Vector3i, key: Vector4i) -> Dictionary:
+	var center := CreatureSpawner._cell_point(c, Ruins.cells_per_face(), Ruins.SALT)
+	var land := Ruins.country(map, center)
+	if land == "snow" or land == "marsh":
+		return {}
+	var brng := RandomNumberGenerator.new()
+	brng.seed = hash([key, "bridge"])
+	if brng.randf() < BRIDGE_CHANCE:
+		var br := _bridge_site(map, center, key, brng)
+		if not br.is_empty():
+			return br
+	var srng := RandomNumberGenerator.new()
+	srng.seed = hash([key, "setpiece"])
+	var where := setting(map, center)
+	var odds: Array = CHANCE.get(where, [0.0, 0.0, 0.0])
+	var roll := srng.randf()
+	var kind := -1
+	if roll < odds[0]:
+		kind = Ruins.Kind.ROTUNDA
+	elif roll < odds[0] + odds[1]:
+		kind = Ruins.Kind.CHAPEL
+	elif roll < odds[0] + odds[1] + odds[2]:
+		kind = Ruins.Kind.MISSION
+	if kind < 0:
+		return {}
+	# The rotunda and the mission on the most prominent rise; the chapel on
+	# the flattest open ground.
+	var level := kind == Ruins.Kind.CHAPEL
+	var best := {}
+	var best_score := -INF
+	for i in 18:
+		var p := CreatureSpawner._offset(center, srng.randf() * TAU, sqrt(srng.randf()) * Ruins.CELL_M * 0.35)
+		var e := map.terrain.elevation(p, true, false)
+		if e < 6.0 or map.water[map.cell_at(p)] != PlanetData.Water.NONE:
+			continue
+		if setting(map, p) != where:
+			continue
+		var ring := 0.0
+		for k in 6:
+			ring += map.terrain.elevation(CreatureSpawner._offset(p, k * TAU / 6.0, 120.0), true, false)
+		var prominence := e - ring / 6.0
+		var slope := 0.0
+		for k in 2:
+			var a := k * PI * 0.5
+			slope = maxf(slope, absf(map.terrain.elevation(CreatureSpawner._offset(p, a, 15.0), true, false) - map.terrain.elevation(CreatureSpawner._offset(p, a + PI, 15.0), true, false)) / 30.0)
+		if slope > (0.1 if level else 0.2):
+			continue
+		var score := (-slope * 40.0 if level else prominence - slope * 20.0) + srng.randf() * 4.0
+		if score > best_score:
+			best_score = score
+			best = {"dir": p}
+	if best.is_empty():
+		return {}
+	# The stair or path (local -z) runs down the steepest way off the site.
+	var low := INF
+	var heading := 0.0
+	for k in 8:
+		var e := map.terrain.elevation(CreatureSpawner._offset(best.dir, k * TAU / 8.0, 25.0), true, false)
+		if e < low:
+			low = e
+			heading = k * TAU / 8.0
+	heading += srng.randf_range(-0.3, 0.3)
+	var site := {"dir": best.dir, "kind": kind, "seed": hash(key), "heading": heading, "style": where}
+	match kind:
+		Ruins.Kind.ROTUNDA:
+			_rotunda_site(site, srng)
+		Ruins.Kind.CHAPEL:
+			_chapel_site(site, srng)
+		Ruins.Kind.MISSION:
+			_mission_site(site, srng)
+	return site
+
+
+## Circles along the local -z axis from z0 to z1 (z1 < z0), `r` wide.
+static func _clear_line(site: Dictionary, x: float, z0: float, z1: float, r: float) -> Array:
+	var out: Array = []
+	var n := maxi(1, int(ceil((z0 - z1) / r)))
+	for i in n + 1:
+		out.append([Ruins.local_dir(site, x, lerpf(z0, z1, float(i) / n)), r])
+	return out
+
+
+## Rotunda: {"ring_r" (the columns' circle), "columns", "col_h",
+## "plinth_r" (the lowest step's edge), "stair_m" (how far the stair runs
+## out from the plinth, down -z)}. The camp sits off the stair's foot.
+static func _rotunda_site(site: Dictionary, rng: RandomNumberGenerator) -> void:
+	site.ring_r = rng.randf_range(4.0, 4.8)
+	site.columns = 8 if rng.randf() < 0.6 else 6
+	site.col_h = rng.randf_range(5.0, 5.8)
+	site.plinth_r = site.ring_r + 2.6
+	site.stair_m = rng.randf_range(12.0, 20.0)
+	var pr: float = site.plinth_r
+	var reach: float = pr + site.stair_m
+	site.footprint_m = reach + 6.0
+	var clear: Array = [[site.dir, pr + 3.0]]
+	clear.append_array(_clear_line(site, 0.0, -pr, -reach - 2.0, 4.5))
+	clear.append([Ruins.local_dir(site, 7.0, -reach + 2.0), 5.0])
+	site.clear = clear
+
+
+## Chapel: {"half_w", "half_l" (the nave, outside), "wall_h", "path_m"
+## (the path's length out from the door, down -z)}. The camp sits by the
+## chapel's front corner on +x.
+static func _chapel_site(site: Dictionary, rng: RandomNumberGenerator) -> void:
+	site.half_w = rng.randf_range(3.3, 3.9)
+	site.half_l = rng.randf_range(5.8, 7.2)
+	site.wall_h = rng.randf_range(4.3, 5.0)
+	site.path_m = rng.randf_range(24.0, 38.0)
+	var hl: float = site.half_l
+	var hw: float = site.half_w
+	site.footprint_m = hl + site.path_m + 3.0
+	var clear: Array = [[site.dir, Vector2(hw, hl).length() + 2.5]]
+	clear.append_array(_clear_line(site, 0.0, -hl, -hl - site.path_m, 2.6))
+	clear.append([Ruins.local_dir(site, hw + 5.0, -hl + 1.0), 5.0])
+	site.clear = clear
+
+
+## Mission: {"half_w", "half_l" (the nave), "tower" (a bell tower's side),
+## "stair_m"} on a terrace reaching `terrace_front` m out in front of the
+## facade (-z). The camp sits on the terrace beside the facade (+x).
+static func _mission_site(site: Dictionary, rng: RandomNumberGenerator) -> void:
+	site.half_w = rng.randf_range(4.6, 5.4)
+	site.half_l = rng.randf_range(9.0, 11.0)
+	site.tower = rng.randf_range(3.6, 4.2)
+	site.terrace_front = rng.randf_range(9.0, 11.0)
+	site.stair_m = rng.randf_range(10.0, 18.0)
+	var hl: float = site.half_l
+	var tx: float = site.half_w + site.tower + 4.0
+	var front: float = hl + site.terrace_front
+	var reach: float = front + site.stair_m
+	site.footprint_m = maxf(reach, Vector2(tx, hl + 3.0).length()) + 4.0
+	var clear: Array = [[site.dir, Vector2(tx, hl + 3.0).length() + 1.0]]
+	clear.append_array(_clear_line(site, 0.0, -hl, -reach - 2.0, 5.0))
+	site.clear = clear
+
+
+## A bridge over a river reach in the cell: {"river_w", "level" (the
+## highest the water can stand there), "bed" (the lowest the channel's
+## bed can be), "span_m" (bank to bank, local x)}. The river runs along
+## local z; the bridge along x. The camp sits on the +x bank.
+static func _bridge_site(map: PlanetData, center: Vector3, key: Vector4i, rng: RandomNumberGenerator) -> Dictionary:
+	var best := {}
+	var best_score := -INF
+	for cell in MagicSites._cells_within(map, center, Ruins.CELL_M * 0.4):
+		if map.water[cell] != PlanetData.Water.RIVER:
+			continue
+		var t := map.flow_to[cell]
+		if t < 0 or map.water[t] != PlanetData.Water.RIVER:
+			continue
+		var la := map.water_level[cell]
+		var lb := minf(map.water_level[t], la)
+		# Tall falls along here: no bridge.
+		if la - lb > BRIDGE_MAX_DROP:
+			continue
+		var w := clampf(RiverNetwork.MIN_WIDTH_M + 3.0 * sqrt(map.flow_accum[cell]), RiverNetwork.MIN_WIDTH_M, RiverNetwork.MAX_WIDTH_M)
+		if w > BRIDGE_MAX_W:
+			continue
+		var mid := (map.dir[cell] + map.dir[t]).normalized()
+		if CubeSphere.surface_distance_m(mid, center) > Ruins.CELL_M * 0.35:
+			continue
+		var span := w + 2.0 * (TerrainChunk.BANK_M + 3.0)
+		# Another reach too near (a confluence, a bend, a stream alongside)?
+		if _other_reach_near(map, cell, t, mid, span * 0.5 + 25.0):
+			continue
+		# Both banks dry land a little above the water.
+		var along := (map.dir[t] - map.dir[cell])
+		along = (along - mid * along.dot(mid)).normalized()
+		var across := mid.cross(along).normalized()
+		var dry := true
+		for s: float in [-1.0, 1.0]:
+			var bank := (mid + across * s * (span * 0.5 + 4.0) / PlanetConst.RADIUS_M).normalized()
+			var bc := map.cell_at(bank)
+			if map.water[bc] == PlanetData.Water.OCEAN or map.water[bc] == PlanetData.Water.LAKE:
+				dry = false
+			if map.terrain.elevation(bank, true, false) < lb - 2.0:
+				dry = false
+		if not dry:
+			continue
+		var score := rng.randf() - (la - lb) * 0.2
+		if score > best_score:
+			best_score = score
+			var depth := 1.2 + w * 0.05
+			best = {"dir": mid, "along": along, "across": across, "river_w": w, "level": la, "bed": lb - depth, "span_m": span}
+	if best.is_empty():
+		return {}
+	# Local x (RuinBuilder's ex) runs across the river: heading + 90 degrees
+	# is the angle of `across` from north.
+	var d: Vector3 = best.dir
+	var ac: Vector3 = best.across
+	var a := atan2(ac.dot(CubeSphere.east(d)), ac.dot(CubeSphere.north(d)))
+	var site := {"dir": d, "kind": Ruins.Kind.BRIDGE, "seed": hash(key), "heading": a - PI * 0.5,
+		"style": setting(map, d), "river_w": best.river_w, "level": best.level, "bed": best.bed, "span_m": best.span_m}
+	# Room for approach ramps either side.
+	var half: float = best.span_m * 0.5 + 16.0
+	site.footprint_m = half + 4.0
+	var clear: Array = []
+	var n := int(half * 2.0 / 6.0)
+	for i in n + 1:
+		clear.append([Ruins.local_dir(site, -half + i * half * 2.0 / n, 0.0), 6.0])
+	site.clear = clear
+	return site
+
+
+## Does a river reach other than cell -> t (and the reaches running on
+## from either end) pass within `r` m of `p`?
+static func _other_reach_near(map: PlanetData, cell: int, t: int, p: Vector3, r: float) -> bool:
+	var seen := {}
+	for base in [cell, t]:
+		for k in 9:
+			var n: int = base if k == 8 else map.neighbors[base * 8 + k]
+			if n < 0 or seen.has(n):
+				continue
+			seen[n] = true
+			if map.water[n] != PlanetData.Water.RIVER:
+				continue
+			var m := map.flow_to[n]
+			if m < 0 or n == cell:
+				continue
+			# The reaches just upstream and downstream meet ours at its ends,
+			# half a cell away: only others count.
+			if m == cell or n == t:
+				continue
+			var pa := map.dir[n]
+			var ab := map.dir[m] - pa
+			var tt := clampf((p - pa).dot(ab) / maxf(ab.length_squared(), 1e-12), 0.0, 1.0)
+			if CubeSphere.surface_distance_m((pa + ab * tt).normalized(), p) < r:
+				return true
+	return false
