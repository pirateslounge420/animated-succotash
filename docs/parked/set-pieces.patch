+## A column drum lying on the ground at (x, z), fallen long ago.
+func _fallen_drum(x: float, z: float, r: float, l: float) -> void:
+	var yaw := rng.randf() * TAU
+	var axis := Vector3(cos(yaw), 0.0, sin(yaw))
+	var g := minf(ground(x - axis.x * l * 0.5, z - axis.z * l * 0.5), ground(x + axis.x * l * 0.5, z + axis.z * l * 0.5))
+	# The drum's axis (the lathe's y) lies along `axis`.
+	var basis := Basis(Vector3.UP, axis, Vector3.UP.cross(axis).normalized())
+	var c := Vector3(x, g + r * 0.8, z) - axis * l * 0.5
