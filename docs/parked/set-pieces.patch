+	_lathe(Transform3D(basis, c), prof, 14, palette[rng.randi() % palette.size()], _growth(0.6), false, 6)
+	if solid:
+		_collision_box(Transform3D(basis, c + axis * l * 0.5), Vector3(r * 0.8, l * 0.5, r * 0.8))
