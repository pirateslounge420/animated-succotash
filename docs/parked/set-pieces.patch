+	for t in 3:
+		var rad: float = tiers[t][0]
+		var inner := rad - (1.3 if t == 2 else 1.0)
+		var n := int(ceil(TAU * rad / 1.25))
+		for k in n:
+			var a0 := TAU * k / n
+			var a1 := TAU * (k + 1) / n
+			var am := (a0 + a1) * 0.5
+			if t < 2 and sin(am) < 0.0 and absf(cos(am) * rad) < stair_w * 0.5 + 0.55:
+				continue
+			var p: Array = []
+			for i in 8:
+				var a := a1 if i & 1 else a0
+				var r := rad if i & 4 else inner
+				p.append(Vector3(cos(a) * r, tiers[t][2] if i & 2 else tiers[t][1], sin(a) * r))
+			var col: Color = (palette[rng.randi() % palette.size()] as Color).lightened(rng.randf_range(-0.05, 0.03))
+			_hexa(p, col, _growth(0.45))
+	_mark('The floor inside the top rin')
+	# The floor inside the top ring, and a core below it.
