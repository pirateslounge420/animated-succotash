+		box(Transform3D(Basis.IDENTITY, Vector3(0.0, (ys[i] + bottom) * 0.5, (z0 + z1) * 0.5)), Vector3(w, ys[i] - bottom, z1 - z0), col, _growth(0.3), 0.06, 0.02)
+	solid = was
+	var foot := z_top - steps * run
+	# Cheek walls in runs of five treads, their tops following the stair.
+	var i0 := 0
+	while i0 < steps:
+		var i1 := mini(i0 + 4, steps - 1)
+		var za := z_top - (i1 + 1) * run
+		var zb := z_top - i0 * run + (0.3 if i0 == 0 else 0.0)
+		var ya := ys[i1] + 0.55
+		var yb := (ys[i0] if i0 > 0 else y_top) + 0.55
+		var low := INF
+		for k in range(i0, i1 + 1):
+			low = minf(low, lows[k])
+		for sx: float in [-1.0, 1.0]:
+			var xi := sx * w * 0.5
+			var xo := sx * (w * 0.5 + 0.6)
