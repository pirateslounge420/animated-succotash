+# --- Bridge ---------------------------------------------------------------------
+
+## A stone bridge across the river (along local x; the water runs along
+## z): round arches on piers with cutwaters, the largest in the middle
+## and the deck humped over them, a string course, parapets with coping,
+## and approach ramps down (or up) to the banks. The arch rings are wedge
+## voussoirs; the piers run down past the river bed.
+func _bridge() -> void:
+	match site.style:
+		"desert":
+			palette = SANDSTONE
+		_:
+			palette = STONES
+	var w: float = site.river_w
+	var span: float = site.span_m
+	var n := 3 if w < 16.0 else (5 if w < 30.0 else 7)
+	var mid := n / 2
+	var f := 0.78
+	var pw := clampf(span / (n * 5.5), 1.8, 3.2)
+	var fsum := 0.0
+	for i in n:
+		fsum += pow(f, absf(i - mid))
+	var s0 := clampf((span - (n - 1) * pw) / fsum, 5.0, 18.0)
+	var spans: Array[float] = []
+	var total := (n - 1) * pw
+	for i in n:
+		spans.append(s0 * pow(f, absf(i - mid)))
+		total += spans[i]
+	var xa := -total * 0.5
+	var xb := total * 0.5
+	var gl := ground(xa - 1.0, 0.0)
+	var gr := ground(xb + 1.0, 0.0)
+	_mark("(The water's levels are elev")
+	# (The water's levels are elevations; the builder works from base_e.)
+	var lv: float = float(site.level) - base_e
+	var bed: float = float(site.bed) - base_e
+	var r_end := spans[0] * 0.5
+	var spring := maxf(lv + 1.0, maxf(gl, gr) - 0.6 - r_end - 1.1)
+	var y0: float = minf(bed - 4.0, minf(gl, gr) - 8.0)
+	_mark('The deck line: over each cro')
