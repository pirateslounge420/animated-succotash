diff --git a/shaders/look.gdshaderinc b/shaders/look.gdshaderinc
index bced8c6..0a9fadc 100644
--- a/shaders/look.gdshaderinc
+++ b/shaders/look.gdshaderinc
@@ -170,6 +170,19 @@ vec4 retro_tex(sampler2D tex, vec2 uv) {
 	return textureLod(tex, uv, clamp(lod, 0.0, look_max_mips));
 }
 
+// retro_tex with the coordinate's screen gradients given (gx, gy: d uv /
+// d screen x and y), for a shader that takes its derivatives once, before
+// any discard or branch: Metal leaves dFdx undefined after a discard and in
+// branches only some pixels of a quad take (Mike's Mac, 1 Oct: leaf cards
+// drawn as flat grey squares, their mip the 1x1 average).
+vec4 retro_tex_g(sampler2D tex, vec2 uv, vec2 gx, vec2 gy) {
+	vec2 ts = vec2(textureSize(tex, 0));
+	vec2 dx = gx * ts;
+	vec2 dy = gy * ts;
+	float lod = 0.5 * log2(max(max(dot(dx, dx), dot(dy, dy)), 1e-8));
+	return textureLod(tex, uv, clamp(lod, 0.0, look_max_mips));
+}
+
 // One of Look's mid-grey modulation tiles (grass, dirt, sand, stone, bark,
 // leaves, water: 0.5 = unchanged), nearest-filtered with at most
 // look_max_mips mips, its contrast pushed by look_tile_contrast (§AG 1).
@@ -178,3 +191,10 @@ vec4 retro_tile(sampler2D tex, vec2 uv) {
 	c.rgb = 0.5 + (c.rgb - 0.5) * (1.0 + look_tile_contrast);
 	return c;
 }
+
+// retro_tile with the coordinate's screen gradients given (retro_tex_g).
+vec4 retro_tile_g(sampler2D tex, vec2 uv, vec2 gx, vec2 gy) {
+	vec4 c = retro_tex_g(tex, uv, gx, gy);
+	c.rgb = 0.5 + (c.rgb - 0.5) * (1.0 + look_tile_contrast);
+	return c;
+}
